# Copier vers ~/.config/morning-press/relay.env puis : chmod 600 ~/.config/morning-press/relay.env
MORNING_PRESS_URL="https://morning-press.alwaysbeshels.workers.dev"
CF_ACCESS_CLIENT_ID="xxxxxxxx.access"
CF_ACCESS_CLIENT_SECRET="remplacer-par-le-secret"
# Nom de l'imprimante dans CUPS (voir `lpstat -p`).
PRINTER="HP_Smart_Tank_6000"
# Options facultatives passées à lp.
LP_OPTIONS="-o sides=two-sided-long-edge -o media=Letter"
