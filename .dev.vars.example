# Copy this file to .dev.vars (never commit .dev.vars) for local development.
# In production, set each value with: npx wrangler secret put NAME
# See docs/SETUP.md for the full walkthrough.

# Neon → your project → Connect → pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Nylas → App Settings → API Keys, and the app Client ID
NYLAS_API_KEY=""
NYLAS_CLIENT_ID=""

# Cloudflare Zero Trust (not required locally when DEV_AUTH_EMAIL is set)
ACCESS_TEAM_DOMAIN="your-team.cloudflareaccess.com"
ACCESS_AUD=""
ALLOWED_EMAILS="you@example.com"

# Local only: bypasses Access on localhost with this identity
DEV_AUTH_EMAIL="you@example.com"
